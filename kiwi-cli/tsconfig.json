  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "outDir": "dist",
    "lib": [
      "es6",
      "es2016.array.include"
    ],
    "types": ["node"],
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": "src",
    "esModuleInterop": true
